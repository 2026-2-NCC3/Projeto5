{
  "name": "proxima-etapa-api",
  "version": "1.0.0",
  "description": "API REST do aplicativo Próxima Etapa",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
